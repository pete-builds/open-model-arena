# Open Model Arena — Example Configuration
#
# Copy this file to models.yaml and edit with your own providers and models.
# Any OpenAI-compatible API endpoint works (OpenAI, Anthropic via LiteLLM, Ollama, etc.)
#
# Model ids below were checked against each provider's own docs on 2026-11-12.
# Model lineups change often: confirm the ids against your provider before use.

providers:
  # Example: OpenAI direct
  openai:
    base_url: "https://api.openai.com/v1"
    api_key_env: "OPENAI_API_KEY"       # reads from environment variable
    request_surcharge: 0.0
    timeout: 30

  # Example: Local Ollama
  ollama:
    base_url: "http://localhost:11434/v1"
    api_key: "ollama"                    # Ollama accepts any string
    request_surcharge: 0.0
    timeout: 120                         # local models can be slower
    local: true                          # prevents pairing two local models

  # Example: LiteLLM proxy / custom gateway
  # gateway:
  #   base_url: "https://your-litellm-proxy.com/v1"
  #   api_key_env: "GATEWAY_API_KEY"
  #   request_surcharge: 0.002
  #   timeout: 30

models:
  # --- Cloud models (via OpenAI) ---
  # Ids and prices: https://developers.openai.com/api/docs/models and
  # https://developers.openai.com/api/docs/pricing (standard tier, short context).

  - id: gpt-6-1-sol
    provider: openai
    display_name: "GPT-6.1 Sol"
    model_id: "gpt-6.1-sol"
    input_cost_per_1m: 2.00
    output_cost_per_1m: 10.0
    categories: [general, coding, reasoning, creative]
    enabled: true
    # reasoning: controls the "thinking" selector in the arena UI.
    #   (omitted)  auto: send reasoning_effort when asked, retry without it on a 400
    #   true       the model supports reasoning_effort; a 400 is a real error
    #   false      never send reasoning_effort to this model
    # reasoning: false

  - id: gpt-6-luna
    provider: openai
    display_name: "GPT-6 Luna"
    model_id: "gpt-6-luna"
    input_cost_per_1m: 0.10
    output_cost_per_1m: 0.50
    categories: [general, coding, creative]
    enabled: true

  # --- Local models (via Ollama) ---
  # Tags: https://ollama.com/library/gemma4 and https://ollama.com/library/gpt-oss
  # Pull them first, for example: ollama pull gemma4:e4b

  - id: gemma4-e4b
    provider: ollama
    display_name: "Gemma 4 E4B (Local)"
    model_id: "gemma4:e4b"
    input_cost_per_1m: 0.0
    output_cost_per_1m: 0.0
    categories: [general, coding, reasoning]
    enabled: true

  - id: gpt-oss-20b
    provider: ollama
    display_name: "gpt-oss 20B (Local)"
    model_id: "gpt-oss:20b"
    input_cost_per_1m: 0.0
    output_cost_per_1m: 0.0
    categories: [general, creative]
    enabled: true

  # --- Anthropic via a gateway (uncomment the gateway provider above) ---
  # Ids and prices: https://platform.claude.com/docs/en/about-claude/models/overview
  # - id: claude-sonnet-5-5
  #   provider: gateway
  #   display_name: "Claude Sonnet 5.5"
  #   model_id: "claude-sonnet-5-5"
  #   input_cost_per_1m: 2.0
  #   output_cost_per_1m: 10.0
  #   categories: [general, coding, reasoning, creative]
  #   enabled: true
  #
  # - id: claude-haiku-5-5
  #   provider: gateway
  #   display_name: "Claude Haiku 5.5"
  #   model_id: "claude-haiku-5-5"
  #   input_cost_per_1m: 0.10     # Anthropic lists Haiku 5.5 as "from" this price
  #   output_cost_per_1m: 0.50
  #   categories: [general, coding, creative]
  #   enabled: true
  #
  # A judge-only model: enabled: false keeps it out of battles.
  # - id: claude-opus-5-5
  #   provider: gateway
  #   display_name: "Claude Opus 5.5"
  #   model_id: "claude-opus-5-5"
  #   input_cost_per_1m: 4.0
  #   output_cost_per_1m: 20.0
  #   categories: [general, coding, reasoning, creative]
  #   enabled: false

# --- LLM-as-judge (optional) ---
#
# When set, a "let <model> decide" button appears in the battle view. The
# judge sees both responses labelled A/B, evaluates them against the
# rubric, and returns a JSON verdict which is recorded as an automated
# vote (method = "judge") in the audit log. A human vote is always still
# available; the judge just adds a second option.
#
# The judge SHOULD be a strong model that is NOT one of the models in the
# battle: a model grading its own answer is biased. Keep the judge as a
# separate, disabled entry (like claude-opus-5-5 above) so it never competes.
# Judge cost is tracked separately in the audit log.
#
# judge:
#   model: claude-opus-5-5   # must match an id in the models list above
#   # rubric: |              # optional; a sane default is used when omitted
#   #   Score correctness first, then helpfulness, then clarity.
