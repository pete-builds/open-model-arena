# Per-service config for the nix1 auto-deploy script
# (/home/pete/scripts/mcp-autodeploy.sh).
#
# Copy to /home/pete/scripts/mcp-autodeploy/model-arena.env, chmod 600.
# Then add a cron entry (staggered from the other services):
#
#   30 5 * * * /home/pete/scripts/mcp-autodeploy.sh model-arena \
#     >> /home/pete/scripts/mcp-autodeploy/model-arena.log 2>&1
#
# The script watches GHCR for a new semver tag, sed-bumps this repo's
# docker-compose.override.yml (a gitignored, host-specific pin), and does
#   docker compose pull && docker compose up -d
# then waits for the container HEALTHCHECK to go green (90s timeout) and
# pings Discord. On unhealthy → restores the backup override, restarts,
# re-checks, and pings 🔴.
#
# See:
#   https://pete-builds.github.io/open-model-arena/guides/deployment/
#   memory/homelab-autodeploy-pipeline.md (private notes)

REPO="pete-builds/open-model-arena"
CONTAINER="model-arena"
COMPOSE_DIR="/home/pete/docker/model-arena"
OVERRIDE="${COMPOSE_DIR}/docker-compose.override.yml"
HEALTH_TIMEOUT_S=90
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/<REDACTED>"
